# ─────────────────────────────────────────────────────────────
# Upstash Redis — Required for the visitor counter
# ─────────────────────────────────────────────────────────────
# 1. Go to https://console.upstash.com/
# 2. Create a new Redis database (choose "Global" for best performance)
# 3. Copy the REST URL and REST Token
# 4. Paste them below in your Vercel project settings

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_secret_token_here
